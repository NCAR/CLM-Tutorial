#!/usr/bin/env python3
"""
Render the MyST/Jinja2 substitutions (parse: myst_substitutions in _config.yml)
into the notebooks, so they read correctly in plain JupyterLab (e.g. NCAR JupyterHub).

Only markdown cells are rendered (that's all MyST substitutes). Because JupyterLab
doesn't know the {parsed-literal} directive, those fences are turned into plain
code fences and inline-code backticks inside them are removed.

This is from Claude Opus 5.5 medium, on Nov 13th, 2026 by Erik Kluzek.

Usage:
    ./render_substitutions.py -o OUTDIR      # copy notebooks/ and images/ into OUTDIR, render the copy
    ./render_substitutions.py --in-place     # render notebooks/ in place (destroys the templates!)
"""
import argparse
import json
import pathlib
import re
import shutil
import sys

import jinja2
import yaml

ROOT = pathlib.Path(__file__).resolve().parent

# ``` {parsed-literal}  ...  ```
# (an unclosed fence runs to the end of the cell)
PARSED_LITERAL = re.compile(r"^(`{3,}) *\{(parsed-literal)\}[^\n]*\n(.*?)(?:^\1[ \t]*$|\Z)", re.M | re.S)
# :::{container} ...   and its closing :::
CONTAINER = re.compile(r"^:{3,}(\{container\}.*)?[ \t]*(\n|\Z)", re.M)


def get_substitutions():
    """Read the substitution values from _config.yml"""
    with open(ROOT / "_config.yml", encoding="utf-8") as cfg:
        config = yaml.safe_load(cfg)
    return config["parse"]["myst_substitutions"]


def fix_parsed_literal(text):
    """Turn {parsed-literal} blocks into plain bash code blocks without inline-code markup"""

    # NOTE: This is tightly coupled to the PARSED_LITERAL regex above.
    def repl(match):
        fence, code_type, body = match.group(1), match.group(2), match.group(3)
        # drop inline-code markup and the \: used to stop MyST auto-linking URLs
        body = body.replace("`", "").replace("\\:", ":")
        if not body.endswith("\n"):
            body += "\n"
        return fence + "bash" + "\n" + body + fence

    text = PARSED_LITERAL.sub(repl, text)
    # JupyterLab shows the :::{container} wrapper lines as text, drop them
    return CONTAINER.sub("", text)


def render_notebook(path, env, subs):
    """Render the markdown cells of one notebook, return True if it changed, abort if bad syntax"""
    with open(path, encoding="utf-8") as fh:
        text = fh.read()
    # Keep the notebook's own JSON indent (Jupyter uses 1, some editors use 2 or 4)
    match = re.search(r'^( +)"', text, re.M)
    indent = len(match.group(1)) if match else 1
    try:
        nb = json.loads(text)
    except json.JSONDecodeError as err:
        sys.exit(f"ERROR:invalid notebook {path}: {err}")
        return False

    changed = False
    for cell in nb["cells"]:
        if cell["cell_type"] != "markdown":
            continue
        source = "".join(cell["source"])
        new = source
        if "{{" in source or "{%" in source:
            try:
                new = env.from_string(source).render(**subs)
            except jinja2.TemplateError as err:
                sys.exit(f"ERROR rendering {path}: {err}")
        new = fix_parsed_literal(new)
        # Jinja strips a single trailing newline, keep the original ending
        if source.endswith("\n") and not new.endswith("\n"):
            new += "\n"
        if new != source:
            cell["source"] = new.splitlines(keepends=True)
            changed = True

    if changed:
        with open(path, "w", encoding="utf-8") as fh:
            json.dump(nb, fh, indent=indent, ensure_ascii=False)
            if text.endswith("\n"):
                fh.write("\n")
    return changed


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("-o", "--outdir", type=pathlib.Path, help="Directory to write rendered notebooks/ to")
    group.add_argument("--in-place", action="store_true", help="Overwrite the notebooks in notebooks/")
    args = parser.parse_args()

    src = ROOT / "notebooks"
    if args.in_place:
        dest = src
    else:
        outdir = args.outdir.resolve()
        if outdir.exists():
            sys.exit(f"ERROR: {outdir} already exists")
        dest = outdir / "notebooks"
        shutil.copytree(src, dest)
        # Notebooks reference ../../images etc., keep those relative links working
        shutil.copytree(ROOT / "images", outdir / "images")

    env = jinja2.Environment(undefined=jinja2.StrictUndefined, keep_trailing_newline=True)
    subs = get_substitutions()
    notebooks = sorted(p for p in dest.rglob("*.ipynb") if ".ipynb_checkpoints" not in p.parts)
    nchanged = sum(render_notebook(nb, env, subs) for nb in notebooks)
    print(f"Rendered {nchanged} notebooks under {dest}")
    print( "Successfully rendered all notebooks")


if __name__ == "__main__":
    main()
